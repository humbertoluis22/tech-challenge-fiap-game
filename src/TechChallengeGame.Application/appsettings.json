{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry"],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "TechChallengeGame": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://otel-lgtm:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
          "service.name": "tech-challenge-game-api",
          "service.version": "1.0.0"
          }
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithCorrelationId"],
    "Properties": {
      "ServiceName": "fcg-catalog-service"
    }
  },
  "SqsConsumer": {
    "QueueUrl": "https://sqs.sa-east-1.amazonaws.com/208452488125/catalog-events-queue"
  },
  "SnsPublisher": {
    "TopicArn": "arn:aws:sns:sa-east-1:208452488125:fcg-events"
  },
  "SqsPublisher": {
    "QueueUrl": "https://sqs.sa-east-1.amazonaws.com/208452488125/payment-events-queue"
  },

  "Elasticsearch": {
    "Uri": "https://my-elasticsearch-project-fdc740.es.us-east-1.aws.elastic.cloud/",
    "ApiKey": "YzZhMU9Kc0I2V1U3d24xODlRRy06dE5rNkZ5N2dmb1VUWXpidVNYUE1xdw=="
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres-db;Port=5432;Database=TechChallengeGame;Username=postgres;Password=TechChallenge2024@"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
