{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "nodeUris": "http://otel-lgtm:4317",
          "protocol": "Grpc"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithNewRelicLogsInContext"],
    "Properties": {
      "ServiceName": "fcg-catalog-service"
    }
  },
  "SqsConsumer": {
    "QueueUrl": "https://sqs.sa-east-1.amazonaws.com/208452488125/catalog-events-queue"
  },
