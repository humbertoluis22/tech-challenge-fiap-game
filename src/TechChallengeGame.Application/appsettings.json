{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Elasticsearch",
        "Args": {
          //"nodeUris": "http://elasticsearch:9200",
          "nodeUris": "http://localhost:9200",
          "indexFormat": "techchallengegame-logs-{0:yyyy.MM.dd}",
          "typeName": null,
          "autoRegisterTemplate": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "TechChallengeGame.API"
    }
  },
  "SqsConsumer": {
    "QueueUrl": "https://sqs.us-east-2.amazonaws.com/208452488125/catalog-events-queue"
  },
  "SnsPublisher": {
    "TopicArn": "arn:aws:sns:us-east-2:208452488125:fcg-events"
  },
  "SqsPublisher": {
    "QueueUrl": "https://sqs.us-east-2.amazonaws.com/208452488125/payment-events-queue"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=TechChallengeGameDb;Username=postgres;Password=root"
    //"DefaultConnection": "Host=postgres-db;Port=5432;Database=TechChallengeGame;Username=postgres;Password=12345"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
