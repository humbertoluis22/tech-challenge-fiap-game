    "QueueUrl": "https://sqs.sa-east-1.amazonaws.com/208452488125/payment-events-queue"
  },

  "Elasticsearch": {
    "Uri": "https://my-elasticsearch-project-ba9d4e.es.us-central1.gcp.elastic.cloud",
